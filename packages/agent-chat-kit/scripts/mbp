#!/usr/bin/env bash
# Swift and SwiftUI only build on macOS. On a Mac the command runs in this
# working tree; anywhere else the tree is mirrored to mbp over SSH first.
# Usage: scripts/mbp swift test
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "$(uname)" = Darwin ]; then
  exec bash -c "$*"
fi

remote_dir="${AGENTCHATKIT_REMOTE_DIR:-code/projects/AgentChatKit}"

rsync -a --delete --exclude .build --exclude .git --exclude .swiftpm --exclude DerivedData ./ "void@mbp:$remote_dir/"
status=0
ssh void@mbp "cd $remote_dir && $*" || status=$?
# Dependency resolution happens on mbp; keep the lockfile in the repo.
rsync -a "void@mbp:$remote_dir/Package.resolved" ./ 2>/dev/null || true
exit "$status"
