      "expect": "null"
    },
    {
      "name": "one",
      "images": "[{\"data\":\"aGVsbG8=\",\"mimeType\":\"image/png\"}]",
      "expect": "null"
    },
    {
      "name": "four",
      "images": "[{\"data\":\"aGVsbG8=\",\"mimeType\":\"image/png\"},{\"data\":\"AAAA\",\"mimeType\":\"image/png\"},{\"data\":\"AAAA\",\"mimeType\":\"image/png\"},{\"data\":\"AAAA\",\"mimeType\":\"image/png\"}]",
      "expect": "null"
    },
    {
      "name": "five",
      "images": "[{\"data\":\"aGVsbG8=\",\"mimeType\":\"image/png\"},{\"data\":\"aGVsbG8=\",\"mimeType\":\"image/png\"},{\"data\":\"aGVsbG8=\",\"mimeType\":\"image/png\"},{\"data\":\"aGVsbG8=\",\"mimeType\":\"image/png\"},{\"data\":\"!!!\",\"mimeType\":\"image/heic\"}]",
      "expect": "\"At most 4 images per message\""
    },
    {
      "name": "unsupported-first",
      "images": "[{\"data\":\"aGVsbG8=\",\"mimeType\":\"image/heic\"}]",
      "expect": "\"Unsupported image type: image/heic (use JPEG, PNG, GIF or WebP)\""
    },
    {
      "name": "unsupported-second",
      "images": "[{\"data\":\"aGVsbG8=\",\"mimeType\":\"image/png\"},{\"data\":\"AAAA\",\"mimeType\":\"image/svg+xml\"}]",
