      "expect": "\"Image 1 is not valid base64\""
    },
    {
      "name": "pad-middle",
      "images": "[{\"data\":\"AAAA=AAA\",\"mimeType\":\"image/png\"}]",
      "expect": "\"Image 1 is not valid base64\""
