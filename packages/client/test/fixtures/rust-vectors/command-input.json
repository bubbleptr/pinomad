{
  "parseCommandInput": [
    {
      "name": "bare",
      "text": "/compact",
      "names": "[\"compact\"]",
      "expect": "{\"name\":\"compact\"}"
    },
    {
      "name": "with-args",
      "text": "/compact keep API notes",
      "names": "[\"compact\"]",
      "expect": "{\"name\":\"compact\",\"args\":\"keep API notes\"}"
    },
    {
      "name": "args-trimmed",
      "text": "/compact   keep API notes  \n",
      "names": "[\"compact\"]",
      "expect": "{\"name\":\"compact\",\"args\":\"keep API notes\"}"
    },
    {
      "name": "trailing-space-only",
      "text": "/compact   ",
      "names": "[\"compact\"]",
      "expect": "{\"name\":\"compact\"}"
    },
    {
      "name": "multiline-args",
      "text": "/compact\n\nkeep API notes\nand the plan",
      "names": "[\"compact\"]",
      "expect": "{\"name\":\"compact\",\"args\":\"keep API notes\\nand the plan\"}"
    },
    {
      "name": "tab-separator",
      "text": "/compact\tnotes",
      "names": "[\"compact\"]",
      "expect": "{\"name\":\"compact\",\"args\":\"notes\"}"
    },
    {
      "name": "nbsp-separator",
      "text": "/compact notes",
      "names": "[\"compact\"]",
      "expect": "{\"name\":\"compact\",\"args\":\"notes\"}"
    },
    {
      "name": "ideographic-separator",
      "text": "/compact　保留接口说明",
      "names": "[\"compact\"]",
      "expect": "{\"name\":\"compact\",\"args\":\"保留接口说明\"}"
    },
    {
      "name": "bom-follower",
      "text": "/compact﻿",
      "names": "[\"compact\"]",
      "expect": "null"
    },
    {
      "name": "bom-in-args",
      "text": "/compact ﻿notes﻿",
      "names": "[\"compact\"]",
      "expect": "{\"name\":\"compact\",\"args\":\"﻿notes﻿\"}"
    },
    {
      "name": "leading-space",
      "text": " /compact",
      "names": "[\"compact\"]",
      "expect": "null"
    },
    {
      "name": "mid-text",
      "text": "hello /compact",
      "names": "[\"compact\"]",
      "expect": "null"
    },
    {
      "name": "unknown",
      "text": "/foo bar",
      "names": "[\"compact\"]",
      "expect": "null"
    },
    {
      "name": "glued-suffix",
      "text": "/compactX",
      "names": "[\"compact\"]",
      "expect": "null"
    },
    {
      "name": "punctuation-suffix",
      "text": "/compact.",
      "names": "[\"compact\"]",
      "expect": "null"
    },
    {
      "name": "case-sensitive",
      "text": "/Compact",
      "names": "[\"compact\"]",
      "expect": "null"
    },
    {
      "name": "path",
      "text": "/usr/bin/x",
      "names": "[\"compact\",\"usr\"]",
      "expect": "null"
    },
    {
      "name": "slash-only",
      "text": "/",
      "names": "[\"compact\"]",
      "expect": "null"
    },
    {
      "name": "slash-space",
      "text": "/ compact",
      "names": "[\"compact\"]",
      "expect": "null"
    },
    {
      "name": "double-slash",
      "text": "//compact",
      "names": "[\"compact\"]",
      "expect": "null"
    },
    {
      "name": "empty",
      "text": "",
      "names": "[\"compact\"]",
      "expect": "null"
    },
    {
      "name": "no-commands",
      "text": "/compact",
      "names": "[]",
      "expect": "null"
    },
    {
      "name": "longer-name",
      "text": "/compact-all now",
      "names": "[\"compact\",\"compact-all\"]",
      "expect": "{\"name\":\"compact-all\",\"args\":\"now\"}"
    },
    {
      "name": "emoji-args",
      "text": "/compact 😀 keep",
      "names": "[\"compact\"]",
      "expect": "{\"name\":\"compact\",\"args\":\"😀 keep\"}"
    }
  ]
}
