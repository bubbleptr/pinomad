        "password": "p"
      },
      "expect": "{\"url\":\"https://relay.example.com/api/login\",\"init\":{\"method\":\"POST\",\"headers\":{\"content-type\":\"application/json\"},\"body\":\"{\\\"username\\\":\\\"u\\\",\\\"password\\\":\\\"p\\\"}\"}}"
    },
