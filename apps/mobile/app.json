{
  "expo": {
    "name": "PiNomad",
    "slug": "pinomad",
    "version": "0.1.0",
    "scheme": "pinomad",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bubbleptr.pinomad.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "PiNomad connects to a host on your local network or tailnet."
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "PiNomad scans a host's pairing QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e00351f3-d9b2-4e74-8838-57560b9539c6"
      }
    },
    "owner": "kieranx"
  }
}
